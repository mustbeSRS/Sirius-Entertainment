# Development: invented contacts only. Never commit a populated .env.local.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
LOCAL_DEMO=true
LOCAL_DATA_DIR=.data
PUBLIC_REGISTRATION_ENABLED=false
# Local-only test admin addresses; production uses admin_users in PostgreSQL.
ADMIN_EMAILS=
# Optional, founder-approved production recovery sender. No provider enabled by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
